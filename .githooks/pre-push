#!/bin/sh
#
# Verificación antes de subir — complemento de la integración continua.
#
# GitHub Actions (.github/workflows/ci.yml) verifica cada push y pull request
# en una máquina limpia. Este hook corre lo mismo antes de subir, para que un
# fallo se vea aquí y no en el servidor, y añade lo único que Actions no hace:
# la verificación de índices, que necesita una base de datos accesible.
#
# Nació en septiembre de 2026, cuando la cuenta estaba bloqueada por
# facturación y Actions no ejecutaba nada; entonces era la única verificación.
#
# Se instala una sola vez con:
#     git config core.hooksPath .githooks
#
# Va versionado a propósito, para que sea el mismo para todo el que trabaje en
# el proyecto en vez de una costumbre personal de cada uno.
#
# Si hace falta subir algo sin esperar —una rama de trabajo a medias, un
# respaldo del día—:
#     git push --no-verify
# Saltárselo para `main` es otra cosa, y es la que este archivo desaconseja.

echo ""
echo "  Verificando antes de subir. Con --no-verify se omite."
echo ""

cd "$(dirname "$0")/../backend" || exit 1
npm run verificar:todo
resultado=$?

if [ $resultado -ne 0 ]; then
  echo "  No se sube: hay comprobaciones en rojo."
  echo "  Arréglalas, o usa 'git push --no-verify' si sabes lo que haces."
  echo ""
fi

exit $resultado
