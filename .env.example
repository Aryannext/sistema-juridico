# ─────────────────────────────────────────────────────────────────
# Variables de la RAÍZ — solo las lee docker-compose.yml
#
# Cópialo a `.env` en el VPS:  cp .env.example .env
# El `.env` real está en .gitignore y no se sube al repositorio.
#
# Las credenciales de la aplicación (JWT, R2, correo) NO van aquí:
# viven en backend/.env. Ver docs/12-DESPLIEGUE-VPS-COMPARTIDO.md
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL del contenedor ────────────────────────────────────
# Esta base es propia del SGPA y está aislada: no es el PostgreSQL
# del sistema, que comparten otros usuarios del VPS.
POSTGRES_USER=sgpa
POSTGRES_DB=sgpa

# OBLIGATORIA. Genera una larga y aleatoria, por ejemplo con:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# Recuerda que backend/.env debe apuntar a este mismo servicio:
#   DATABASE_URL="postgresql://sgpa:LA_MISMA_CLAVE@postgres:5432/sgpa?schema=public"
#   DIRECT_URL="postgresql://sgpa:LA_MISMA_CLAVE@postgres:5432/sgpa?schema=public"
# El host es "postgres" (el nombre del servicio), NUNCA localhost:
# dentro de un contenedor, localhost es el propio contenedor.

# ── Puerto en el host ────────────────────────────────────────────
# Puerto por el que el Nginx del VPS alcanza la API. Solo escucha en
# 127.0.0.1, así que no queda expuesto a internet.
#
# En este VPS el 3001 ya está ocupado por otro servicio, y el 5432,
# 27017 y 3306 los usan PostgreSQL, MongoDB y MySQL del sistema.
# Para comprobar qué hay libre:  ss -tlnp
SGPA_PUERTO=3005

# ── Compilación del frontend ─────────────────────────────────────
# Ruta pública de la API. Vite la incrusta en el bundle al compilar.
VITE_API_URL=/sistema-juridico/api
