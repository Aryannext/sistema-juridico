{
  "name": "sistema-juridico-backend",
  "version": "1.0.0",
  "description": "Backend para Sistema de Gestión de Procesos de Abogados (SGPA)",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "lint": "eslint .",
    "probar-correo": "node -r dotenv/config scripts/probar-correo.js",
    "probar-almacenamiento": "node -r dotenv/config scripts/probar-almacenamiento.js",
    "verificar:docs": "node scripts/verificar-docs.js",
    "verificar:referencias": "node scripts/verificar-referencias.js",
    "verificar:plataforma": "node -r dotenv/config scripts/verificar-admin-plataforma.js",
    "verificar:indices": "node -r dotenv/config scripts/verificar-indices-busqueda.js",
    "crear-admin-plataforma": "node -r dotenv/config scripts/crear-admin-plataforma.js",
    "defectos": "node -r dotenv/config scripts/reproducir-defectos.js",
    "arreglos": "node -r dotenv/config scripts/verificar-arreglos.js",
    "seed:dev": "node prisma/seed-dev.js",
    "verificar": "node scripts/verificar-plataforma.js",
    "verificar:limpiar": "node scripts/limpiar-datos-verificacion.js",
    "respaldo": "node scripts/respaldo.js",
    "medir:concurrencia": "node scripts/medir-concurrencia.js",
    "verificar:todo": "node scripts/verificar-todo.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.0",
    "pdfkit": "^0.20.2",
    "prisma": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.0",
    "supertest": "^7.2.2"
  }
}
