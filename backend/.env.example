# ─── Base de datos (PostgreSQL) ────────────────────────────────
# EN EL VPS, con Docker: el host es "postgres", el nombre del servicio del
# compose. NUNCA "localhost": dentro de un contenedor, localhost es el propio
# contenedor. La clave debe coincidir con POSTGRES_PASSWORD del .env de la raíz.
#
#   DATABASE_URL="postgresql://sgpa:CLAVE@postgres:5432/sgpa?schema=public"
#   DIRECT_URL="postgresql://sgpa:CLAVE@postgres:5432/sgpa?schema=public"
#
# EN LOCAL, con PostgreSQL instalado en tu máquina:
#   DATABASE_URL="postgresql://postgres:CLAVE@localhost:5432/sistema_juridico?schema=public"
#
# Si algún día se vuelve a una base gestionada con pooler (Supabase y
# similares), DIRECT_URL debe apuntar al puerto directo: las migraciones de
# Prisma no funcionan a través del pooler.
DATABASE_URL="postgresql://sgpa:CLAVE@postgres:5432/sgpa?schema=public"
DIRECT_URL="postgresql://sgpa:CLAVE@postgres:5432/sgpa?schema=public"

# ─── Autenticación ─────────────────────────────────────────────
JWT_SECRET="clave-larga-y-aleatoria-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="8h"

# ─── Almacenamiento de archivos: Cloudflare R2 ─────────────────
# Credenciales del cliente S3 (src/config/cloudflare.js).
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Nombre del bucket. Sin esto NO se puede subir ningún documento ni logo:
# lo usan documentos.controller.js y tenant.controller.js.
R2_BUCKET_NAME=""

# Dominio público del bucket, para construir la URL del logo del consultorio.
# Si se deja vacío, tenant.controller.js arma una URL de respaldo usando
# R2_BUCKET_NAME y R2_ACCOUNT_ID.
R2_PUBLIC_DOMAIN=""

# Solo se usa en esa URL de respaldo. Si defines R2_PUBLIC_DOMAIN, es opcional.
R2_ACCOUNT_ID=""

# ─── Correo saliente (Gmail SMTP) ──────────────────────────────
GMAIL_USER="tucorreo@gmail.com"
# Contraseña de aplicación de 16 caracteres, no la contraseña normal de la cuenta.
GMAIL_PASS=""

# ─── Servidor ──────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# Base de los enlaces de verificación que se envían por correo.
# En producción debe apuntar al dominio real, incluida la subcarpeta.
FRONTEND_URL="http://localhost:5173/sistema-juridico"

# Solo para desarrollo: activa la cuenta sin verificar el correo.
# En producción se ignora por diseño (ver src/modules/auth/auth.controller.js).
DEV_AUTO_VERIFY="false"

# ─── Integraciones opcionales ──────────────────────────────────
# Webhook hacia n8n. Si queda vacío, simplemente no se dispara ningún evento.
N8N_WEBHOOK_URL=""

# ───────────────────────────────────────────────────────────────
# NOTA: SUPABASE_URL y SUPABASE_KEY fueron retiradas. Ya no se usa Supabase:
# el almacenamiento de archivos está en Cloudflare R2 (src/config/supabase.js
# quedó desactivado) y la base de datos vive en un contenedor propio
# (ver ADR-011). Detalle en docs/09-COMPATIBILIDAD-NODE.md
